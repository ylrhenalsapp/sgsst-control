# ============================================================================
# SG-SST Control · Variables de entorno
# ----------------------------------------------------------------------------
# Copia este archivo a ".env" y completa los valores reales. El archivo
# ".env" NUNCA se sube al repositorio (ver .gitignore) ni a ningún hosting.
#
# Encuentras estos valores en tu proyecto de Supabase:
#   Project Settings > API
# ============================================================================

# Pública (se usa en el navegador, en assets/js/config.js). La "anon key" de
# Supabase está diseñada para ser pública: por sí sola no da acceso a nada,
# el acceso real lo controlan las políticas de Row Level Security (RLS).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# SECRETA. Solo se usa en scripts que corren en tu computador (por ejemplo
# scripts/seed-admin-user.mjs), NUNCA en el navegador ni en el sitio
# publicado. Si esta clave se filtra, cualquiera tendría acceso total a la
# base de datos: trátala como una contraseña de administrador.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI
